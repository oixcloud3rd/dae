# Copy this file to .env and replace both placeholders. The .env file is
# ignored by Git. Values supplied through the environment take precedence.
# Base64-encoded 32-byte Ed25519 seed for oixCloud DNS authentication.
OIXCLOUD_DNS_AUTH_PRIVATE_KEY=<base64-ed25519-seed>

# Raw HMAC key used to authenticate oixCloud managed subscriptions.
OIXCLOUD_SUBSCRIPTION_HMAC_KEY=<subscription-hmac-key>
